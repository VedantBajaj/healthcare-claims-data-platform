      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT SUM(rejected_rows) AS rejected_rows FROM silver_marts.mart_daily_claim_feed_quality;"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "title": "Latest Pipeline Runs",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS pipeline_runs FROM silver_marts.mart_pipeline_run_audit;"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "title": "Claim Volume by Claim Type",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT claim_type, total_claims FROM silver_marts.mart_claim_volume ORDER BY claim_type;"
        }
      ],
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97
      }
    },
    {
      "id": 6,
      "title": "Claim Payments by Claim Type",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT claim_type, total_claim_payment_amount FROM silver_marts.mart_claim_payments ORDER BY claim_type;"
        }
      ],
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97
      }
    },
    {
      "id": 7,
      "title": "Claims by Source System",
      "type": "barchart",
