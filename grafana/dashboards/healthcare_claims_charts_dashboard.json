{
  "uid": "healthcare-claims-charts",
  "title": "Healthcare Claims Platform Charts",
  "tags": ["healthcare", "claims", "postgres", "dbt", "airflow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Total Claims",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT SUM(total_claims) AS total_claims FROM silver_marts.mart_claim_volume;"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Total Claim Payments",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT SUM(total_claim_payment_amount) AS total_claim_payments FROM silver_marts.mart_claim_payments;"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
