      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97
      }
    },
    {
      "id": 9,
      "title": "Pipeline Run Duration",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT started_at AS time, duration_seconds FROM silver_marts.mart_pipeline_run_audit ORDER BY started_at;"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Payment by Source System",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT source_system || ' - ' || claim_type AS source_claim_type, total_claim_payment_amount FROM silver_marts.mart_claims_by_source_system ORDER BY source_system, claim_type;"
        }
      ],
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 25,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97
      }
    },
    {
      "id": 11,
      "title": "Top Providers by Total Claim Payment",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT provider_id, claim_type, total_claims, unique_beneficiaries, total_claim_payment_amount, average_claim_payment_amount, negative_payment_claims FROM silver_marts.mart_provider_performance ORDER BY total_claim_payment_amount DESC LIMIT 10;"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "title": "Pipeline Run Audit",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT pipeline_name, run_id, feed_date, files_processed, total_rows_loaded, successful_files, failed_files, run_status, duration_seconds, started_at, ended_at FROM silver_marts.mart_pipeline_run_audit ORDER BY started_at DESC LIMIT 10;"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
