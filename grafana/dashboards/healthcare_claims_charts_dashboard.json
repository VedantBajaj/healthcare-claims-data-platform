      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT source_system || ' - ' || claim_type AS source_claim_type, total_claims FROM silver_marts.mart_claims_by_source_system ORDER BY source_system, claim_type;"
        }
      ],
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 25,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97
      }
    },
    {
      "id": 8,
      "title": "Daily Feed Quality",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "healthcare_claims_postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT claim_type, bronze_daily_rows, silver_daily_rows, rejected_rows FROM silver_marts.mart_daily_claim_feed_quality ORDER BY claim_type;"
